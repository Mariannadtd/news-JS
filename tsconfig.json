{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Node",
        "lib": ["DOM", "ES2020"],
        "strict": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "allowJs": true,
        "checkJs": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
